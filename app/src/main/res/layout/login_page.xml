<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:gravity="center"
    android:padding="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Title Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to Kairo,"
            android:gravity="center"
            android:textColor="@color/_00000"
            android:textSize="32sp"
        android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your time with ease."
            android:gravity="center"
            android:textColor="@color/_00000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Logo -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/kairobot"
            android:background="@drawable/icon_border"
            android:padding="8dp"
            android:contentDescription="App Logo"/>

        <!-- Username/Email Field -->
        <EditText
            android:id="@+id/username_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="ID or Email"
            android:textColor="@color/white"
            android:textColorHint="#0F54BF"
            android:textSize="20sp"
            android:background="@drawable/rounded_corner"
            android:padding="18dp"
            android:inputType="text"/>

        <!-- Password Field (Material Design) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:endIconMode="password_toggle"
            app:endIconTint="#0F54BF"
            style="@style/CustomTextInputLayout"
            android:background="@drawable/rounded_corner">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:textColor="@color/white"
                android:textColorHint="#0F54BF"
                android:textSize="20sp"
                android:inputType="textPassword"
                android:padding="18dp"/>
        </com.google.android.material.textfield.TextInputLayout>

    <!-- Login Button -->
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Login"
        android:backgroundTint="@color/white"
        android:textColor="#2196F3"
        android:padding="18dp"
        android:textSize="20sp"
        android:id="@+id/login_btn"/>

</LinearLayout>
    </RelativeLayout>