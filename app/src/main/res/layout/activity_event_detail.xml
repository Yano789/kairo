<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Event Image -->
        <ImageView
            android:id="@+id/detailEventImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@drawable/default_event_image"/>

        <!-- Event Name (now EditText) -->
        <EditText
            android:id="@+id/detailEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:inputType="textCapSentences"
            android:layout_marginTop="8dp"
            android:focusable="false" />

        <!-- Event Description (now EditText) -->
        <EditText
            android:id="@+id/detailEventDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Description"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:layout_marginTop="8dp"
            android:focusable="false" />

        <!-- Event Date (remains TextView) -->
        <TextView
            android:id="@+id/detailEventDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Date"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="4dp" />

        <!-- Event Start Time (remains TextView) -->
        <TextView
            android:id="@+id/detailEventStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Time"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="8dp" />

        <!-- Event End Time (remains TextView but will be hidden) -->
        <TextView
            android:id="@+id/detailEventEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End Time"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Event Location (now EditText) -->
        <EditText
            android:id="@+id/detailEventLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent"
            android:inputType="textCapSentences"
            android:layout_marginTop="4dp"
            android:focusable="false" />

        <!-- Event Tags (remains TextView) -->
        <TextView
            android:id="@+id/detailEventTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tags: tech, ai, design"
            android:textSize="14sp"
            android:textColor="@color/purple_500"
            android:layout_marginTop="8dp" />

        <!-- Save Button (new addition) -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>