<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:flexbox="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Full-bleed event image -->
    <ImageView
        android:id="@+id/detailEventImage"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:scaleType="centerCrop"
        android:src="@drawable/default_event_image" />
    <ImageButton
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:id="@+id/backButton"
        android:layout_margin="16dp"
        android:background="@drawable/circle_background"
        android:src="@drawable/ic_black_arrow_left"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:contentDescription="Back"/>

    <!-- Main Content Card -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/white_card_rounded_top"
        android:layout_below="@id/detailEventImage"
        android:layout_marginTop="-40dp"
        android:paddingTop="32dp"
        android:padding="16dp">

        <!-- Event Title -->
        <TextView
            android:id="@+id/detailEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tech Conference"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp" />

        <!-- Event Description -->
        <TextView
            android:id="@+id/detailEventDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Annual technology conference"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="16dp" />

        <!-- Date Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/info_pill_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/detailEventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="April 1, 2025"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Time Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/info_pill_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clock"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/detailEventTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:00 AM – 6:00 PM"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Location Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/info_pill_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_location"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/detailEventLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Convention Center"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/tagsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            flexbox:flexWrap="wrap"
            flexbox:justifyContent="flex_start" />

        <!-- Save Button (new addition) -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>